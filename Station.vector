import { RESPO_LAGE_BOOKABLE } from "./Bookable.js";

export function RESPO_STATION_MASTER(vector) {

    const respo = VectorRESPO(vector);
    const geo = GEO_CORE(vector);
    const radar = RADAR_CORE(geo);
    const evo = EVO_PIPE(vector);

    const master = { respo, geo, radar, evo };

    master.book = RESPO_LAGE_BOOKABLE(master);

    return master;
}
